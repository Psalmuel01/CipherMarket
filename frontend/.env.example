# CipherMarket Frontend — Environment Variables Template
# Copy to .env.local and fill in your deployed contract addresses.
# Run `npx hardhat run scripts/deploy.ts --network sepolia` in /contracts to get these.

# ── Arbitrum Sepolia (chainId 421614) ───────────────────────────────────────────────
NEXT_PUBLIC_ARBITRUM_SEPOLIA_ORACLE_REGISTRY=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_PREDICTION_MARKET=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_MOCK_USDC=

# ── Supabase market discussions ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
