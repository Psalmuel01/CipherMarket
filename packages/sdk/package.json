{
  "name": "@ciphermarket/sdk",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/abi.d.ts",
      "import": "./dist/abi.js",
      "default": "./dist/abi.js"
    },
    "./abi/*": {
      "import": "./dist/abi/*.json"
    },
    "./addresses": {
      "types": "./dist/addresses.d.ts",
      "import": "./dist/addresses.js",
      "default": "./dist/addresses.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./cofhe": {
      "types": "./dist/cofhe.d.ts",
      "import": "./dist/cofhe.js",
      "default": "./dist/cofhe.js"
    },
    "./disputes": {
      "types": "./dist/disputes.d.ts",
      "import": "./dist/disputes.js",
      "default": "./dist/disputes.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./formatters": {
      "types": "./dist/formatters.d.ts",
      "import": "./dist/formatters.js",
      "default": "./dist/formatters.js"
    },
    "./gas": {
      "types": "./dist/gas.d.ts",
      "import": "./dist/gas.js",
      "default": "./dist/gas.js"
    },
    "./marketMath": {
      "types": "./dist/marketMath.d.ts",
      "import": "./dist/marketMath.js",
      "default": "./dist/marketMath.js"
    },
    "./markets": {
      "types": "./dist/markets.d.ts",
      "import": "./dist/markets.js",
      "default": "./dist/markets.js"
    },
    "./portfolio": {
      "types": "./dist/portfolio.d.ts",
      "import": "./dist/portfolio.js",
      "default": "./dist/portfolio.js"
    },
    "./quotes": {
      "types": "./dist/quotes.d.ts",
      "import": "./dist/quotes.js",
      "default": "./dist/quotes.js"
    },
    "./redemption": {
      "types": "./dist/redemption.d.ts",
      "import": "./dist/redemption.js",
      "default": "./dist/redemption.js"
    },
    "./trading": {
      "types": "./dist/trading.d.ts",
      "import": "./dist/trading.js",
      "default": "./dist/trading.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@cofhe/sdk": "^0.5.2",
    "viem": "^2.37.13"
  },
  "devDependencies": {
    "@cofhe/sdk": "^0.5.2",
    "typescript": "^5.7.3",
    "viem": "^2.37.13",
    "vitest": "^2.1.9"
  }
}
